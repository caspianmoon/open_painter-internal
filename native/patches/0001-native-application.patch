diff --git a/source/blender/editors/space_info/space_info.cc b/source/blender/editors/space_info/space_info.cc
index a464ed42..6daa9ce7 100644
--- a/source/blender/editors/space_info/space_info.cc
+++ b/source/blender/editors/space_info/space_info.cc
@@ -251,8 +251,58 @@ static void info_space_blend_write(BlendWriter *writer, SpaceLink *sl)
   writer->write_struct_cast<SpaceInfo>(sl);
 }
 
+// Open Painter native dock editors share only the simple SpaceInfo storage layout.
+// They own their region drawing; no viewport draw handler or image streaming is used.
+static SpaceLink *painter_assets_create(const ScrArea *area, const Scene *scene)
+{
+  SpaceLink *sl = info_create(area, scene);
+  sl->spacetype = SPACE_PAINTER_ASSETS;
+  static_cast<ARegion *>(sl->regionbase.first)->flag |= RGN_FLAG_HIDDEN;
+  return sl;
+}
+static SpaceLink *painter_layers_create(const ScrArea *area, const Scene *scene)
+{
+  SpaceLink *sl = info_create(area, scene);
+  sl->spacetype = SPACE_PAINTER_LAYERS;
+  static_cast<ARegion *>(sl->regionbase.first)->flag |= RGN_FLAG_HIDDEN;
+  return sl;
+}
+static void painter_listener(const wmRegionListenerParams *params)
+{
+  ED_region_tag_redraw(params->region);
+}
+static void painter_register(const bool assets)
+{
+  auto st = std::make_unique<SpaceType>();
+  st->spaceid = assets ? SPACE_PAINTER_ASSETS : SPACE_PAINTER_LAYERS;
+  STRNCPY_UTF8(st->name, assets ? "Painter Assets" : "Painter Layers");
+  st->create = assets ? painter_assets_create : painter_layers_create;
+  st->free = info_free;
+  st->init = info_init;
+  st->duplicate = info_duplicate;
+  st->blend_write = info_space_blend_write;
+  auto *art = MEM_new_zeroed<ARegionType>("painter panels");
+  art->regionid = RGN_TYPE_WINDOW;
+  art->keymapflag = ED_KEYMAP_UI | ED_KEYMAP_VIEW2D;
+  art->init = ED_region_panels_init;
+  art->layout = ED_region_panels_layout;
+  art->draw = ED_region_panels;
+  art->listener = painter_listener;
+  BLI_addhead(&st->regiontypes, art);
+  art = MEM_new_zeroed<ARegionType>("painter header");
+  art->regionid = RGN_TYPE_HEADER;
+  art->prefsizey = HEADERY;
+  art->keymapflag = ED_KEYMAP_UI | ED_KEYMAP_HEADER;
+  art->init = info_header_region_init;
+  art->draw = info_header_region_draw;
+  BLI_addhead(&st->regiontypes, art);
+  BKE_spacetype_register(std::move(st));
+}
+
 void ED_spacetype_info()
 {
+  painter_register(true);
+  painter_register(false);
   std::unique_ptr<SpaceType> st = std::make_unique<SpaceType>();
   ARegionType *art;
 
